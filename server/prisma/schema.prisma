generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccounts ConnectedAccount[]
  games             UserGame[]
  playtimeSnapshots PlaytimeSnapshot[]
}

model ConnectedAccount {
  id         String @id @default(cuid())
  userId     String

  platform   String
  externalId String
  username   String?
  avatarUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
}

model Game {
  id         String @id @default(cuid())
  platform   String
  externalId String

  name      String
  imageUrl  String?
  genres    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userGames         UserGame[]
  playtimeSnapshots PlaytimeSnapshot[]

  @@unique([platform, externalId])
}

model UserGame {
  id     String @id @default(cuid())
  userId String
  gameId String

  // Current cumulative playtime from the platform
  playtimeMinutes Int @default(0)

  // When the platform says the game was last played
  lastPlayedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model PlaytimeSnapshot {
  id     String @id @default(cuid())
  userId String
  gameId String

  playtimeMinutes Int

  snapshotDate DateTime @default(now())
  recordedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, snapshotDate])
  @@index([userId, snapshotDate])
  @@index([userId, gameId, snapshotDate])
}